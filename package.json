{
  "name": "xauusd-quant-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.10.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "validate:dev": "npm run build && node scripts/validate-dev-dataset.mjs",
    "preflight:v1r1": "npm run build && node dist/quant-core/cli/run-nested-v1.js --preflight-only",
    "run:nested:v1r1": "npm run build && node dist/quant-core/cli/run-nested-v1.js",
    "preflight:final-dev:v1r1": "npm run build && node dist/quant-core/cli/run-final-dev-v1r1.js --preflight-only",
    "run:final-dev:v1r1": "npm run build && node dist/quant-core/cli/run-final-dev-v1r1.js",
    "preflight:final-signal:v1r1": "npm run build && node dist/quant-core/cli/run-final-signal-v1r1.js --preflight-only",
    "run:final-signal:v1r1": "npm run build && node dist/quant-core/cli/run-final-signal-v1r1.js",
    "preflight:risk:v1": "npm run build && node dist/quant-core/cli/run-risk-preflight-v1.js",
    "preflight:execution:v1": "npm run build && node dist/quant-core/cli/run-execution-preflight-v1.js",
    "preflight:economic:v1": "npm run build && node dist/quant-core/cli/run-economic-preflight-v1.js",
    "preflight:economic:v1r1": "npm run build && node dist/quant-core/cli/run-economic-preflight-v1r1.js",
    "preflight:economic:v1r2": "npm run build && node dist/quant-core/cli/run-economic-preflight-v1r2.js",
    "run:economic-lockbox:v1r1": "npm run build && node dist/quant-core/cli/run-economic-lockbox-v1r1.js",
    "run:economic-lockbox:v1r2": "npm run build && node dist/quant-core/cli/run-economic-lockbox-v1r2-production.js",
    "demo:paper-monitor:v1": "npm run build && node dist/quant-core/cli/run-paper-journal-demo-v1.js",
    "replay:dev-signal:v1": "npm run build && node dist/quant-core/cli/run-dev-signal-replay-v1.js",
    "run:nested:v1": "npm run build && node dist/quant-core/cli/run-nested-v1.js"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "@types/node": "22.10.2"
  }
}
